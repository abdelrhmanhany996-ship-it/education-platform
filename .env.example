# انسخ هذا الملف باسم .env ثم عدّل القيم. لا ترفع ملف .env إلى أي مكان.
# Copy to .env and fill in. Never commit .env.

# --- Server -------------------------------------------------------------
PORT=3000
# Token signing key. Leave empty and one is generated once into server/data/.auth-secret
AUTH_SECRET=
# One-click demo logins on the landing page. Set to false before real students use it.
ALLOW_DEMO_LOGIN=true

# --- Firebase Firestore (database) ---------------------------------------
# Leave empty to store everything in a local file (server/data/db.json) while you try the app.
# Firebase console > Project settings > Service accounts > "Generate new private key".
# Put the downloaded file in this folder and write its name (or paste the JSON on one line).
FIREBASE_SERVICE_ACCOUNT=firebase-service-account.json
FIREBASE_PROJECT_ID=

# --- WhatsApp Cloud API (Meta) -------------------------------------------
# Meta for Developers > your app > WhatsApp > API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Numbers written as 01012345678 get this country code in front (20 = Egypt).
DEFAULT_COUNTRY_CODE=20
# Needed to message a student who has not written to your number in the last 24 hours.
# An approved template whose body contains exactly one variable: {{1}}
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=ar

# --- Telegram Bot (direct messages + account linking) ---------------------
# Create a bot with @BotFather on Telegram, then paste the token it gives you.
TELEGRAM_BOT_TOKEN=
# Optional: only needed if auto-detection from the token fails.
TELEGRAM_BOT_USERNAME=
# Personal account (messages any number, no bot Start needed): my.telegram.org > API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Email (doctor approval links for new enrollments) --------------------
# Leave empty to skip real email; the approval link is still logged to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Public URL used to build the "قبول الطلب" link inside the doctor's email.
APP_URL=http://localhost:3000

# How often the automatic alert sender checks students, in milliseconds.
ALERT_CHECK_MS=300000
